# Optional run settings (NOT credentials). Use with:  --env-file .env   (repeatable; later files win)
# Credentials live in separate per-tenant files: see .env.source.example / .env.target.example
# Precedence: CLI flag > this file > process environment > built-in default.

#REPLICATOR_SCAN_TYPES=sast,iac,api,sca     # any of sast, iac(kics), api(apisec), sca. No default
#REPLICATOR_OUTPUT_DIR=./src-export
#REPLICATOR_STATE_DB=./replicator-state.sqlite
#REPLICATOR_LOG_DIR=./logs
#REPLICATOR_DOWNLOAD_WORKERS=4
#REPLICATOR_UPLOAD_WORKERS=4
#REPLICATOR_QUEUE_MAX=500

# Legacy (still honoured, lower priority than the per-tenant files):
#CXONE_T1_API_KEY= / CXONE_T1_TENANT= / CXONE_T1_BASE_URL= / CXONE_T1_IAM_URL=
