# cxone-scan-replicator: example env file. Copy to e.g. .env-prod and chmod 600.
# Use it with:  python main.py --env-file .env-prod ...
# Several files may be given (--env-file .env-t1 --env-file .env-t2); later files win.
# Precedence per value: CLI flag > env file(s) > process environment > built-in default.

# ---- Tenant 1 (source) --------------------------------------------------------
# Only the API key is strictly required: tenant, base URL and IAM URL are derived from
# the key's JWT (iss claim / ast-base-url claim) when left unset.
CXONE_T1_API_KEY=
#CXONE_T1_TENANT=
#CXONE_T1_BASE_URL=https://eu.ast.checkmarx.net
#CXONE_T1_IAM_URL=https://eu.iam.checkmarx.net

# ---- Tenant 2 (destination) ----------------------------------------------------
CXONE_T2_API_KEY=
#CXONE_T2_TENANT=
#CXONE_T2_BASE_URL=https://us.ast.checkmarx.net
#CXONE_T2_IAM_URL=https://us.iam.checkmarx.net

# ---- Optional run defaults ------------------------------------------------------
# Engines to run in Tenant2 (REQUIRED for replicate / --from-manifest, from here or --scan-types).
# Any of: sast, iac (alias kics), api (alias apisec), sca. No default.
#REPLICATOR_SCAN_TYPES=sast,iac,api,sca

#REPLICATOR_OUTPUT_DIR=./src-export          # download-only output
#REPLICATOR_STATE_DB=./replicator-state.sqlite
#REPLICATOR_LOG_DIR=./logs
#REPLICATOR_DOWNLOAD_WORKERS=4               # download-only default is 8
#REPLICATOR_UPLOAD_WORKERS=4
#REPLICATOR_QUEUE_MAX=500
